# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/wnraudit

# ─── Clerk Authentication ─────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_live_...
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
# Optional: only needed when Clerk is proxied through the API server
VITE_CLERK_PROXY_URL=https://your-domain.com/api/__clerk

# ─── Anthropic AI ─────────────────────────────────────────────────────────────
AI_INTEGRATIONS_ANTHROPIC_API_KEY=sk-ant-...
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com

# ─── Microsoft Entra / Azure AD ───────────────────────────────────────────────
# WNR-Audit multi-tenant App Registration (client ID: 7324093c-8f5d-4efe-92d2-aa845c8f0542)
MS_OAUTH_CLIENT_ID=7324093c-8f5d-4efe-92d2-aa845c8f0542
MS_OAUTH_CLIENT_SECRET=your-app-registration-secret
# Optional override for OAuth redirect URI (defaults to REPLIT_DEV_DOMAIN or FRONTEND_BASE_URL)
MS_OAUTH_REDIRECT_URI=https://your-domain.com/api/oauth/ms/callback

# ─── Server / CORS ────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
# Full base URL of the frontend (used for CORS, tracking pixel URLs, OAuth redirects)
FRONTEND_BASE_URL=https://your-domain.com
# Base path of the SPA within the domain (e.g. /wnraudit or /)
BASE_PATH=/wnraudit/

# ─── Session ──────────────────────────────────────────────────────────────────
# Random secret used to sign state parameters in OAuth flows
SESSION_SECRET=change-me-to-a-long-random-string

# ─── SMTP — Phishing simulation email dispatch ────────────────────────────────
# Required only when running phishing campaigns; leave blank to disable dispatch.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=phishing@example.com
SMTP_PASS=your-smtp-password

# ─── Optional / Development ───────────────────────────────────────────────────
LOG_LEVEL=info
# Set by Replit automatically; used to derive redirect URIs in dev
# REPLIT_DEV_DOMAIN=your-repl-id.replit.dev
