# =============================================================
#  WNR-Audit — variáveis de ambiente
#  Domínio de produção: wnrtecnologia.com.br/wnraudit
#  Copie este arquivo para source/.env e preencha os valores.
# =============================================================

# --- Servidor ---
NODE_ENV=production
PORT=8080

# --- Banco de dados ---
DATABASE_URL=postgres://wnraudit:TROQUE_ESSA_SENHA@127.0.0.1:5432/wnraudit

# --- Sessão (gere com: openssl rand -hex 32) ---
SESSION_SECRET=

# --- Clerk (https://dashboard.clerk.com) ---
CLERK_SECRET_KEY=sk_live_...
CLERK_PUBLISHABLE_KEY=pk_live_...
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

# --- Clerk Proxy (opcional — proxy interno para domínio customizado) ---
# VITE_CLERK_PROXY_URL=https://wnrtecnologia.com.br/api/__clerk

# --- Microsoft OAuth (App Registration "WNR-Audit", multi-tenant) ---
MS_OAUTH_CLIENT_ID=7324093c-8f5d-4efe-92d2-aa845c8f0542
MS_OAUTH_CLIENT_SECRET=
MS_OAUTH_REDIRECT_URI=https://wnrtecnologia.com.br/api/oauth/ms/callback

# --- Microsoft Admin Console (App Registration "WNR-API", multi-tenant) ---
# Opcional e preferencial. Quando configurado, substitui o MS_OAUTH_CLIENT_ID/SECRET
# nos novos consentimentos OAuth e nas chamadas app-only do Admin Console.
WNR_API_CLIENT_ID=
WNR_API_CLIENT_SECRET=

# --- Frontend ---
FRONTEND_BASE_URL=https://wnrtecnologia.com.br/wnraudit
# Caminho base do Vite (deve terminar com /) — padrão /wnraudit/ se omitida
BASE_PATH=/wnraudit/

# --- Anthropic (Consultas inteligentes) ---
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_INTEGRATIONS_ANTHROPIC_API_KEY=sk-ant-...
