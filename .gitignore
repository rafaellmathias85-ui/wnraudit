# =============================================================
#  .gitignore raiz — WNR-Audit
# =============================================================

# Segredos e dados de produção (NUNCA commitar)
.env
.env.local
.env.*.local
db/*.json

# Dependências e artefatos de build (gerados no VPS)
source/node_modules/
source/**/node_modules/
source/**/dist/
source/**/.tsbuildinfo
source/**/*.tsbuildinfo

# Sistema operacional
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Replit
.cache/
.local/
.replit
replit.md
